[Unit]
Description=Open the DecentralChain node and dashboard ports
After=ufw.service

[Service]
Type=oneshot
# Node peer-to-peer port: open to the internet so other nodes can connect.
ExecStart=/usr/bin/ufw allow 6868/tcp
# Dashboard: home and office networks only, never the internet.
ExecStart=/usr/bin/ufw allow from 10.0.0.0/8 to any port 6870 proto tcp
ExecStart=/usr/bin/ufw allow from 172.16.0.0/12 to any port 6870 proto tcp
ExecStart=/usr/bin/ufw allow from 192.168.0.0/16 to any port 6870 proto tcp
# Setup hotspot (the box hands out 10.42.0.x): addresses, name lookups and the page itself.
ExecStart=/usr/bin/ufw allow 67/udp
ExecStart=/usr/bin/ufw allow from 10.42.0.0/24 to any port 53
ExecStart=/usr/bin/ufw allow from 10.42.0.0/24 to any port 80 proto tcp
# decentralos.local name on the home network.
ExecStart=/usr/bin/ufw allow 5353/udp

[Install]
WantedBy=multi-user.target
