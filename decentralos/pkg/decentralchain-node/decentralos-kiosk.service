[Unit]
Description=DecentralOS node dashboard on screen
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 30); do curl -fs -o /dev/null http://127.0.0.1:6870/ && exit 0; sleep 1; done'
ExecStart=/usr/bin/chromium --kiosk --app=http://127.0.0.1:6870/ --no-first-run --noerrdialogs --disable-session-crashed-bubble --user-data-dir=%h/.local/share/decentralos-kiosk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
