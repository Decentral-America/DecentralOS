#!/bin/bash

# Check on this computer's DecentralChain node from a terminal. The owner's
# everyday view is the dashboard (decentralos-node open); this is for support.
# Usage: decentralos-node [open|status|logs|seed|bar]

set -euo pipefail

CONF=/etc/decentralchain/dcc.conf
API_KEY_FILE=/etc/decentralchain/api-key
SERVICE=decentralchain-node.service
API=http://127.0.0.1:6869
DASHBOARD=http://127.0.0.1:6870/

api() { curl -fsS --max-time 5 "$API$1" "${@:2}"; }

unbase58() {
  python3 -c '
import sys
a = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
n = 0
for c in sys.stdin.read().strip():
    n = n * 58 + a.index(c)
print(n.to_bytes((n.bit_length() + 7) // 8, "big").decode(errors="replace"))'
}

open_dashboard() {
  systemctl --user start decentralos-kiosk.service 2>/dev/null || xdg-open "$DASHBOARD"
}

status() {
  if [[ ! -f $CONF ]]; then
    echo "The node is not set up yet. Open the dashboard to start it: decentralos-node open"
    return 1
  fi
  local height peers last behind sync
  height=$(api /node/status 2>/dev/null | jq -r .blockchainHeight || true)
  peers=$(api /peers/connected 2>/dev/null | jq -r '.peers | length' || true)
  last=$(api /blocks/headers/last 2>/dev/null | jq -r .timestamp || true)
  sync="waiting for the node"
  if [[ $last =~ ^[0-9]+$ ]]; then
    behind=$(($(date +%s) - last / 1000))
    if ((behind < 180)); then sync="in sync"; else sync="syncing, $((behind / 86400))d $((behind % 86400 / 3600))h behind"; fi
  fi
  echo "Service:  $(systemctl is-active "$SERVICE" || true)"
  echo "Sync:     $sync"
  echo "Height:   ${height:--}"
  echo "Peers:    ${peers:--}"
  echo "Address:  $(api /addresses 2>/dev/null | jq -r '.[0] // "-"' || echo -)"
}

# One line of JSON for the bar widget. Short timeouts: it is polled every few seconds.
bar_status() {
  if [[ ! -f $CONF ]]; then
    echo '{"state":"unconfigured"}'
    return
  fi
  local height peers last behind state=syncing
  if ! height=$(curl -fsS --max-time 2 "$API/node/status" 2>/dev/null | jq -er .blockchainHeight); then
    echo '{"state":"offline"}'
    return
  fi
  peers=$(curl -fsS --max-time 2 "$API/peers/connected" 2>/dev/null | jq -r '.peers | length' || echo 0)
  last=$(curl -fsS --max-time 2 "$API/blocks/headers/last" 2>/dev/null | jq -r .timestamp || echo 0)
  behind=$(($(date +%s) - ${last:-0} / 1000))
  ((behind < 180)) && state=synced
  jq -cn --arg state "$state" --argjson height "$height" --argjson peers "${peers:-0}" --argjson behind "$behind" '{state: $state, height: $height, peers: $peers, behind: $behind}'
}

case "${1:-}" in
  open | setup) open_dashboard ;;
  status) status ;;
  logs) journalctl -u "$SERVICE" -f -n 200 ;;
  seed) api /wallet/seed -H "X-API-Key: $(sudo cat "$API_KEY_FILE")" | jq -r .seed | unbase58 ;;
  bar) bar_status ;;
  "") if [[ -n ${WAYLAND_DISPLAY:-} ]]; then open_dashboard; else status; fi ;;
  *)
    echo "Usage: decentralos-node [open|status|logs|seed|bar]" >&2
    exit 1
    ;;
esac
