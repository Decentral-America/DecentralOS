[Unit]
Description=DecentralOS node dashboard
After=network.target

[Service]
User=decentralchain
Group=decentralchain
ExecStart=/usr/bin/python3 /usr/share/decentralos/dashboard/server.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
# Port 80 on the setup hotspot, so a phone opens the dashboard by itself after joining.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/decentralchain /var/lib/decentralchain

[Install]
WantedBy=multi-user.target
