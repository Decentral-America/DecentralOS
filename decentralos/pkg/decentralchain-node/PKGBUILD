# Maintainer: Decentral America

pkgname=decentralchain-node
pkgver=1.7.0
pkgrel=5
pkgdesc="DecentralChain blockchain node with first-boot setup for DecentralOS"
arch=('any')
url="https://github.com/Decentral-America/node-scala"
license=('MIT')
depends=('java-runtime-headless>=25' 'curl' 'jq' 'python' 'qrencode' 'iproute2')
makedepends=('git' 'sbt' 'java-environment>=25')
backup=('etc/decentralchain/node.env')
install=decentralchain-node.install
source=("node-scala::git+$url.git#tag=v$pkgver"
        'decentralchain-node'
        'decentralos-node'
        'decentralos-autologin'
        'decentralos-node-update'
        'decentralchain-node.service'
        'decentralchain-node.path'
        'decentralchain-node-reload.service'
        'decentralos-dashboard.service'
        'decentralos-firewall.service'
        'decentralos-autologin.service'
        'decentralos-node-update.service'
        'decentralos-node-update.timer'
        'decentralos-kiosk.service'
        'decentralchain-node.desktop'
        'network.rules'
        'node.env'
        'sysusers.conf'
        'tmpfiles.conf'
        'sleep.conf'
        'seed-words.txt'
        'server.py'
        'index.html')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
  cd node-scala
  sbt --batch node/Universal/packageZipTarball
}

package() {
  install -d "$pkgdir/usr/share/decentralchain"
  bsdtar -xf node-scala/node/target/universal/decentralchain*.tgz \
    --strip-components=1 -C "$pkgdir/usr/share/decentralchain"

  for network in mainnet testnet; do
    install -Dm644 "node-scala/node/decentralchain-$network.conf" "$pkgdir/usr/share/decentralchain/conf/$network.conf"
  done
  install -Dm644 seed-words.txt "$pkgdir/usr/share/decentralchain/seed-words.txt"

  install -Dm644 -t "$pkgdir/usr/share/decentralos/dashboard" server.py index.html

  install -Dm755 -t "$pkgdir/usr/bin" decentralchain-node decentralos-node decentralos-autologin decentralos-node-update
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" decentralchain-node.service decentralchain-node.path     decentralchain-node-reload.service decentralos-dashboard.service decentralos-firewall.service     decentralos-autologin.service decentralos-node-update.service decentralos-node-update.timer
  # The kiosk starts in every graphical session without per-user setup.
  install -Dm644 decentralos-kiosk.service "$pkgdir/usr/lib/systemd/user/decentralos-kiosk.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../decentralos-kiosk.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/decentralos-kiosk.service"
  install -Dm644 network.rules "$pkgdir/usr/share/polkit-1/rules.d/50-decentralos-network.rules"
  install -Dm644 decentralchain-node.desktop "$pkgdir/usr/share/applications/decentralchain-node.desktop"
  install -Dm644 node.env "$pkgdir/etc/decentralchain/node.env"
  install -Dm644 sysusers.conf "$pkgdir/usr/lib/sysusers.d/decentralchain.conf"
  install -Dm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/decentralchain.conf"
  install -Dm644 sleep.conf "$pkgdir/usr/lib/systemd/sleep.conf.d/10-decentralchain.conf"
}
